# Copy to .env and adjust. Real environment variables override these values.
# The server also loads .env.local on top of .env (same syntax).

# --- Bind address / port (localhost only when fronted by nginx) ---
SERVER_HOST=127.0.0.1
SERVER_PORT=9090

# Public wss:// base the CLIENT can reach. /servers.ini and STARTG advertise
# URLs built from this, so it must be the externally visible one.
#   production: wss://service.thaira2.com
#   local test: ws://127.0.0.1:9090
EXTERNAL_URL=wss://service.thaira2.com

# Path the WOL WebSocket is served at (keeps it clear of the static web root).
WOL_URL_PATH=/wol
# Path the GSERV (match) WebSocket is served at.
GSERV_URL_PATH=/gserv
GSERV_ID=gs1

# GSERV_RATE_LIMIT=disabled
# Network turn period (ms) broadcast to players at game start (RPL_NET_RATE 802).
GSERV_NET_RATE_MS=33
# Where finished-match replays (.rpl) are written. Recording is opt-in: set
# RECORD_REPLAYS=true to enable the server-side replay recorder. It writes a
# replay for every gserv instance that starts and ends.
# RECORD_REPLAYS=true
# REPLAYS_DIR=server/replays

# Ladder/ranked is not implemented yet; advertises in servers.ini only.
GAME_VERSION=0.83.2

# --- Auth / accounts ---
GLOBAL_CHANNEL_PASS=zotclot9
SESSION_TTL_SECONDS=86400
MIN_USERNAME_LENGTH=2
MAX_USERNAME_LENGTH=15
MIN_PASSWORD_LENGTH=8
MAX_PASSWORD_LENGTH=128
FRESH_ACCOUNT_AGE_SECONDS=86400

# --- Lobby behavior ---
MATCH_BOT_NAME=matchbot
SERVER_MOTD=Welcome to RA2Web\ngood luck and have fun
PING_INTERVAL_SECONDS=30
# EXPECTED_MOD_HASH=deadbeef...

# --- Abuse protection ---
# Max WebSocket frame size and HTTP request body (bytes). Game action frames
# are far below this; it only caps floods.
# MAX_PAYLOAD_BYTES=262144
# Abandoned gserv instances (players never connected) are swept after this many
# seconds.
# GSERV_INSTANCE_TTL_SECONDS=600
# If at least one player has joined an instance but the full roster never
# gathered and the game did not start within this many seconds, the instance is
# aborted and the waiting players are disconnected (prevents a permanently
# frozen loading screen).
# GSERV_START_TIMEOUT_SECONDS=180
# Per-connection flood limiting on the match relay. Disable only for testing
# (e.g. to rule out the limiter when diagnosing in-game stutter):
# GSERV_RATE_LIMIT=disabled
# Live per-instance stats: every N seconds, active games log received
# frames/s and relayed ticks/s per player (0 disables). Watch real packet
# rates during play to see whether the rate limiter is dropping frames.
# GSERV_STATS_INTERVAL_SECONDS=5
# HTTP login/register throttling per IP (behind nginx the X-Forwarded-For IP is
# used).
# LOGIN_MAX_PER_MIN=30
# REGISTER_MAX_PER_HOUR=20

# --- Logging ---
# LOG_LEVEL=debug | info (default) | warn | error
LOG_LEVEL=info
# The server writes its own rotating log file ("" disables file logging).
# Relative paths are resolved against the working directory. Rotation happens
# when the file exceeds LOG_MAX_BYTES (default 100MB) or the calendar day
# changes (LOG_ROTATE_DAILY, default on). LOG_MAX_FILES backups are kept
# (server.log, server.log.1 .. server.log.N).
LOG_FILE=logs/server.log
LOG_MAX_BYTES=104857600
LOG_MAX_FILES=5
LOG_ROTATE_DAILY=true

# --- CORS: list the PAGE origin(s) that connect to this server, NOT the server
# host. WebSocket upgrades are rejected with 403 unless the handshake Origin is
# listed. ---
CORS_ALLOWED_ORIGINS=https://play.thaira2.com

# --- Storage ---
# STORAGE=sqlite | memory
STORAGE=sqlite
# DB_PATH=server/data/ra2web.sqlite
