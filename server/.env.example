# Copy to .env and adjust. Real environment variables override these values.
# The server also loads .env.local on top of .env (same syntax).

# --- Bind address / port (localhost only when fronted by nginx) ---
SERVER_HOST=127.0.0.1
SERVER_PORT=9090

# Public wss:// base the CLIENT can reach. /servers.ini and STARTG advertise
# URLs built from this, so it must be the externally visible one.
#   production: wss://service.thaira2.com
#   local test: ws://127.0.0.1:9090
EXTERNAL_URL=wss://service.thaira2.com

# Path the WOL WebSocket is served at (keeps it clear of the static web root).
WOL_URL_PATH=/wol
# Path the GSERV (match) WebSocket is served at.
GSERV_URL_PATH=/gserv
GSERV_ID=gs1
# Network turn period (ms) broadcast to players at game start (RPL_NET_RATE 802).
GSERV_NET_RATE_MS=33
# Where finished-match replays (.rpl) are written. The server writes replays for
# every gserv instance that starts and ends.
# REPLAYS_DIR=server/replays

# Ladder/ranked is not implemented yet; advertises in servers.ini only.
GAME_VERSION=0.83.2

# --- Auth / accounts ---
GLOBAL_CHANNEL_PASS=zotclot9
SESSION_TTL_SECONDS=86400
MIN_USERNAME_LENGTH=2
MAX_USERNAME_LENGTH=15
MIN_PASSWORD_LENGTH=8
MAX_PASSWORD_LENGTH=128
FRESH_ACCOUNT_AGE_SECONDS=86400

# --- Lobby behavior ---
MATCH_BOT_NAME=matchbot
SERVER_MOTD=Welcome to RA2Web\ngood luck and have fun
PING_INTERVAL_SECONDS=30
# EXPECTED_MOD_HASH=deadbeef...

# --- Logging ---
# LOG_LEVEL=debug | info (default) | warn | error
LOG_LEVEL=info

# --- CORS: list the PAGE origin(s) that connect to this server, NOT the server
# host. WebSocket upgrades are rejected with 403 unless the handshake Origin is
# listed. ---
CORS_ALLOWED_ORIGINS=https://play.thaira2.com

# --- Storage ---
# STORAGE=sqlite | memory
STORAGE=sqlite
# DB_PATH=server/data/ra2web.sqlite
